# 生产环境必填：Postgres 连接串（Neon / Supabase 都可以）。不填时本地使用内置的 PGlite 数据库（.data 目录）。
DATABASE_URL=

# ===== AI 模型：二选一 =====

# 方案 A：国内模型（阿里云百炼 / 通义千问，支付宝付费）。也适用于其他兼容 OpenAI 格式的服务（DeepSeek、Kimi、智谱等）。
AI_PROVIDER=openai
AI_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
AI_API_KEY=
# 识别文字用的模型
AI_MODEL=qwen-plus
# 识别扫描件和图片用的模型（必须支持图片）
AI_VISION_MODEL=qwen3-vl-plus
# 可选：单次最多输出多少 token，默认 16384，模型不支持时会自动降到 8192
AI_MAX_OUTPUT_TOKENS=

# 方案 B：Anthropic Claude（需要海外付款方式）。用这个方案时删掉上面的 AI_PROVIDER 等几行。
# ANTHROPIC_API_KEY=
# ANTHROPIC_MODEL=claude-sonnet-5-5

# 仅本地测试：设为 1 时 AI 返回 AI_MOCK_DIR 目录里的固定结果，不调用 API
AI_MOCK=
AI_MOCK_DIR=
